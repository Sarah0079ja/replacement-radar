# Optional for founder demo. When present, /login uses Supabase password auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional presentation control. Defaults to true for the founder-test MVP.
# Set to false to hide DCAD owner names and mailing addresses from the UI/export.
NEXT_PUBLIC_SHOW_OWNER_DETAILS=true

# Server-side only. Required by `npm run seed:opportunities`; never expose this
# as NEXT_PUBLIC_* or commit it.
SUPABASE_SERVICE_ROLE_KEY=
